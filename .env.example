# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PocketBase Backend Configuration
# Deployment instance: https://cosmo-pb.prkln.app
POCKETBASE_URL="https://cosmo-pb.prkln.app"
NEXT_PUBLIC_POCKETBASE_URL="https://cosmo-pb.prkln.app"
POCKETBASE_BOOKINGS_COLLECTION="bookings"
POCKETBASE_ARTICLES_COLLECTION="articles"
# Optional PocketBase admin credentials if collections require authentication
POCKETBASE_ADMIN_EMAIL=""
POCKETBASE_ADMIN_PASSWORD=""

# Third-party SMS provider (GET request with credentials in the query string)
BASE_URL="https://smssmartegypt.com/sms/api"
USERNAME=""
PASSWORD=""
SENDERNAME=""
