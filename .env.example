# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PocketBase Backend Configuration
POCKETBASE_URL="https://server.drkaz.dev"
NEXT_PUBLIC_POCKETBASE_URL="https://server.drkaz.dev"
POCKETBASE_BOOKINGS_COLLECTION="appointments"
POCKETBASE_ARTICLES_COLLECTION="articles"
POCKETBASE_DOCTORS_COLLECTION="doctors"
# Optional PocketBase admin credentials if collections require authentication
POCKETBASE_ADMIN_EMAIL=""
POCKETBASE_ADMIN_PASSWORD=""

# Custom SMS Provider Configuration
SMS_PROVIDER_URL="https://notifier.drkaz.dev"
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_AUTH_HEADER="Authorization"
SMS_CLINIC_TOPIC="01091966224"
SMS_SENDER_ID="CosmoSurge"
